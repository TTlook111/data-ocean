# 只供根目录 docker-compose.yml 使用；不会自动配置宿主机 Java/Python。
# 共享基础设施按项目分别启动；为 redis / milvus 等各保存一份私有环境文件。
# 填入随机密码，不提交实际环境文件；启动时只指定该项目所属的服务。
COMPOSE_PROJECT_NAME=redis

# MySQL 首次初始化空数据卷时建立应用账号。DB_NAME 留空时不创建应用库。
# Java 使用 MYSQL_PASSWORD 对应的密码，不使用 root 账号。
DB_NAME=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# MinIO 凭据由 Compose 同时传给 MinIO 和 Milvus，至少 8 字符。
MINIO_ROOT_PASSWORD=

# 仅绑定 127.0.0.1；端口冲突时在本文件修改，并同步应用本地配置。
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_CHECKPOINT_PORT=6380
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
