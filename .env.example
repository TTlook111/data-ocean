# 只供根目录 docker-compose.yml 使用；不会自动配置宿主机 Java/Python。
# 首次使用复制为 .env，再填入随机密码。不要提交 .env。
COMPOSE_PROJECT_NAME=dataocean

# MySQL：首次创建空数据卷时建立 dataocean 库和 dataocean 应用账号。
# Java 使用 MYSQL_PASSWORD 对应的密码，不使用 root 账号。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# MinIO 凭据由 Compose 同时传给 MinIO 和 Milvus，至少 8 字符。
MINIO_ROOT_PASSWORD=

# 仅绑定 127.0.0.1；端口冲突时在本文件修改，并同步应用本地配置。
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_CHECKPOINT_PORT=6380
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
