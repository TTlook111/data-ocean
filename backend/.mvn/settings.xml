<?xml version="1.0" encoding="UTF-8"?>
<!-- 本项目依赖统一走公开 HTTPS 仓库，不修改机器上其他项目的 Maven 设置。 -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <mirrors>
    <mirror>
      <id>dataocean-central</id>
      <mirrorOf>*</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
