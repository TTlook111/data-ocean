backend/DataOcean/src/main/resources/application-dev.yml
backend/DataOcean/src/main/resources/application-dev.yaml
!.env.example
!.env.*.example
!.env.template
!.env.*.template
# 已确认随项目提供的开发示例变量；真实凭据仍放本机配置。
!/frontend/.env.development

# 本机环境说明和私有密钥；仅保留共享说明模板。
/.dataocean/*
!/.dataocean/local-environment.example.md

# Shared Node dependencies and package-manager caches
# Project runtime selection belongs to each device; compatibility lives in engines.
/frontend/.node-version
.npm-cache/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

