# 正式 Python API 的运行配置；复制为本目录 .env 后由启动脚本显式加载。
# 当前公共基线只有健康接口，模型、Redis 检查点及 Worker 随实际业务接入再配置。

# 宿主机内部监听地址。
DATAOCEAN_AI_HOST=127.0.0.1

# 与 Java 18080 分开的内部 HTTP 端口。
DATAOCEAN_AI_PORT=18090

# 标准日志等级，日志统一使用 UTC。
DATAOCEAN_AI_LOG_LEVEL=INFO

# 表说明生成队列和命名空间，使用部署提供的 Redis 连接。
DATAOCEAN_AI_GOVERNANCE_REDIS_URL=redis://127.0.0.1:6379/0
DATAOCEAN_AI_GOVERNANCE_NAMESPACE=dataocean:governance

# Java 内部 API 地址与服务认证密钥文件路径。
DATAOCEAN_AI_JAVA_URL=http://127.0.0.1:18080
DATAOCEAN_AI_JAVA_PUBLIC_KEY_FILE=../.dataocean/java-public.pem
DATAOCEAN_AI_WORKER_PRIVATE_KEY_FILE=../.dataocean/python-private.pem
