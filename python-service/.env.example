# 复制为 .env，按本机修改。模型只在系统里配置。
AI_HOST=127.0.0.1
AI_PORT=18090
AI_LOG_LEVEL=INFO
AI_LOG_OUTPUT=stdout

# Redis 队列。启用认证时使用 redis://:URL编码后的密码@127.0.0.1:6379/0。
AI_QUEUE_URL=redis://127.0.0.1:6379/0
AI_QUEUE_PREFIX=dataocean:governance

# Java 地址与 JWT 的 PEM 文件路径，从 python-service 计算。
AI_JAVA_URL=http://127.0.0.1:18080
AI_JAVA_PUBLIC_KEY=../.dataocean/java-public.pem
AI_WORKER_PRIVATE_KEY=../.dataocean/python-private.pem

# 检查点和 RAG。Milvus 免认证时 token 留空。
AI_CHECKPOINT_URL=redis://127.0.0.1:6380/0
AI_MILVUS_URI=http://127.0.0.1:19530
AI_MILVUS_TOKEN=
