# DataOcean Python AI Service 环境变量模板
# 复制为 python-service/.env；在 python-service 目录运行 uv 命令。
# 根目录 .env 只供 Compose 使用，不会自动加载到本服务。

# === LLM 初始配置（可选，启动后也可在后台「AI 配置」中设置） ===
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3

# === Milvus 向量库 ===
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=schema_knowledge
# 默认集合名不是 S1 问数的活动知识源；实际使用确认构建后的 buildId 专属集合。

# === RAG 配置 ===
RAG_TOP_K=10
SIMILARITY_THRESHOLD=0.6
EMBEDDING_BATCH_SIZE=25

# === Redis ===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === LangGraph checkpoint（必需，Redis 8 须含 JSON/Search） ===
# 下列默认地址对应可选 Compose 的独立 checkpoint 实例；已有环境改成实际地址，必须使用 DB 0。
# 缺失或能力检查失败时，普通 /health 仍可能正常，但 S1 问数会拒绝执行。
LANGGRAPH_CHECKPOINT_REDIS_URL=redis://127.0.0.1:6380/0

# === LangSmith 可观测性（可选） ===
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=DataOcean

# === 内部服务间认证（必需） ===
# /internal/*（可执行 SQL、可写向量库、可触发 Agent）由该令牌独占保护。
# 它没有默认值：未配置或长度不足 32 个字符时，服务会拒绝启动。
# 必须与 Java 端 dataocean.internal.token 完全一致（Java 读同一个 INTERNAL_TOKEN 环境变量）。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_TOKEN=
# Java 网关地址（Python 回调用，如 /internal/metadata、/internal/prompts、/internal/ai-config）
JAVA_GATEWAY_URL=http://127.0.0.1:8080

# === 服务配置 ===
LOG_LEVEL=INFO
