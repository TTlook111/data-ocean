{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "数据源授权与输出限制",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "prototypes/flows/权限流程.html",
    "legend": {
      "entries": {
        "frontend": {
          "label": "界面操作"
        },
        "backend": {
          "label": "业务处理"
        },
        "security": {
          "label": "授权检查"
        },
        "database": {
          "label": "授权生效"
        },
        "messagebus": {
          "label": "状态变化"
        }
      }
    },
    "views": [
      {
        "id": "source-policy",
        "label": "规则与初始授权",
        "focus": [
          "ruleEdit",
          "assign",
          "use"
        ],
        "note": "部门配置选择已有规则，生效后作为每次访问的授权来源。"
      },
      {
        "id": "access-approval",
        "label": "额外访问与生效",
        "focus": [
          "request",
          "map",
          "approval",
          "commit",
          "refused"
        ],
        "note": "批准只提供执行依据；执行成功才生效，驳回或执行失败均回告原因。"
      },
      {
        "id": "scope-boundary",
        "label": "每次查询与失权处理",
        "focus": [
          "query",
          "use",
          "result",
          "revoke",
          "stop"
        ],
        "note": "查询独立发起并核验当前条件；撤权、调岗或停用独立触发失权处理。"
      }
    ]
  },
  "lanes": [
    {
      "id": "policy",
      "label": "规则与初始授权"
    },
    {
      "id": "employee",
      "label": "额外访问申请"
    },
    {
      "id": "usage",
      "label": "每次查询"
    },
    {
      "id": "changes",
      "label": "未生效与访问中断",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "request",
    "map",
    "approval",
    "commit"
  ],
  "nodes": [
    {
      "id": "ruleEdit",
      "lane": "policy",
      "col": 1,
      "label": "维护输出限制规则",
      "sublabel": "名称与中文限制内容，统一复用",
      "type": "frontend"
    },
    {
      "id": "assign",
      "lane": "policy",
      "col": 4,
      "label": "配置部门初始访问",
      "sublabel": "选择数据源与规则，校验后保存",
      "type": "backend"
    },
    {
      "id": "request",
      "lane": "employee",
      "col": 0,
      "label": "员工提交访问申请",
      "sublabel": "说明业务用途及需要的数据",
      "type": "frontend"
    },
    {
      "id": "map",
      "lane": "employee",
      "col": 1,
      "label": "负责人核定数据源及规则",
      "sublabel": "依据业务用途，查看规则全文",
      "type": "backend"
    },
    {
      "id": "approval",
      "lane": "employee",
      "col": 2,
      "label": "按责任范围审批",
      "sublabel": "批准不等于访问生效",
      "type": "security"
    },
    {
      "id": "commit",
      "lane": "employee",
      "col": 3,
      "label": "校验并执行授权",
      "sublabel": "复核账号、批准版本和授予上限",
      "type": "database"
    },
    {
      "id": "query",
      "lane": "usage",
      "col": 3,
      "label": "员工发起查询",
      "sublabel": "输入业务问题",
      "type": "frontend"
    },
    {
      "id": "use",
      "lane": "usage",
      "col": 4,
      "label": "校验本次查询",
      "sublabel": "安全、功能、数据源、部门与输出规则",
      "type": "security"
    },
    {
      "id": "result",
      "lane": "usage",
      "col": 5,
      "label": "执行并交付结果",
      "sublabel": "仅返回当前权限允许的内容",
      "type": "backend"
    },
    {
      "id": "refused",
      "lane": "changes",
      "col": 2,
      "label": "回告未生效原因",
      "sublabel": "保留审批或执行失败记录",
      "type": "security"
    },
    {
      "id": "stop",
      "lane": "changes",
      "col": 4,
      "label": "中断受影响访问",
      "sublabel": "重算剩余来源，阻断失权部分",
      "type": "security"
    },
    {
      "id": "revoke",
      "lane": "changes",
      "col": 5,
      "label": "撤权、调岗或停用",
      "sublabel": "复核受影响来源、任务及历史",
      "type": "messagebus"
    }
  ],
  "edges": [
    {
      "id": "select-initial",
      "from": "ruleEdit",
      "to": "assign",
      "label": "选用规则",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "select-request",
      "from": "ruleEdit",
      "to": "map",
      "label": "选用规则",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "initial-use",
      "from": "assign",
      "to": "use",
      "label": "初始配置生效",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "submit",
      "from": "request",
      "to": "map",
      "label": "",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "review",
      "from": "map",
      "to": "approval",
      "label": "",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "approved",
      "from": "approval",
      "to": "commit",
      "label": "获批",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "effective",
      "from": "commit",
      "to": "use",
      "label": "执行成功后可用",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "query-check",
      "from": "query",
      "to": "use",
      "label": "",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "allow",
      "from": "use",
      "to": "result",
      "label": "通过校验",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "decline",
      "from": "approval",
      "to": "refused",
      "label": "驳回",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "execution-failed",
      "from": "commit",
      "to": "refused",
      "label": "执行失败",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "refuse",
      "from": "revoke",
      "to": "stop",
      "label": "按实际失权处理",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "title": "每次访问分别核验",
      "items": [
        "角色控制页面、按钮和功能；每次访问按有效所属部门及组织层级识别范围，门店仅本店，上级含本级及下级。",
        "数据源与输出限制按来源核验，不拼接来源扩大访问；分配时不手选部门范围、不逐项勾选表字段、不设置期限。"
      ],
      "dot": "cyan"
    },
    {
      "title": "规则用中文维护与选择",
      "items": [
        "规则示例：用户信息限制，不允许返回身份证和电话；产品成本限制，不允许返回产品成本。",
        "有权限人员维护规则，授权时可多选。规则约束输出，相关字段仍可用于 WHERE 等合法条件。"
      ],
      "dot": "emerald"
    },
    {
      "title": "授权生效与失权处理",
      "items": [
        "部门初始配置仅关联直属及直属兼任成员，下级成员不继承；额外申请获批并执行成功才生效，两类来源独立保留。",
        "撤权仅阻断实际失权部分并重算其他来源；账号停用中断全部访问，保留历史。",
        "共享规则修改的生效方式、多来源限制合并方式待进一步确定，不能默认跨来源解除限制。"
      ],
      "dot": "amber"
    }
  ]
}
