{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "权限与访问申请",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "权限流程.html",
    "legend": {
      "entries": {
        "frontend": {
          "label": "员工操作"
        },
        "backend": {
          "label": "业务处理"
        },
        "security": {
          "label": "授权检查"
        },
        "database": {
          "label": "生效记录"
        },
        "messagebus": {
          "label": "状态变化"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "policy",
      "label": "企业授权"
    },
    {
      "id": "employee",
      "label": "访问申请"
    },
    {
      "id": "changes",
      "label": "拒绝与撤权",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "entry",
      "label": "确定用途与范围",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "decision",
      "label": "审批与生效",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "live",
      "label": "持续核验",
      "fromCol": 4,
      "toCol": 4
    }
  ],
  "mainPath": [
    "request",
    "map",
    "approval",
    "commit",
    "use"
  ],
  "nodes": [
    {
      "id": "roles",
      "lane": "policy",
      "col": 0,
      "type": "backend",
      "icon": "person",
      "label": "配置角色",
      "sublabel": "企业选择操作权限"
    },
    {
      "id": "attach",
      "lane": "policy",
      "col": 1,
      "type": "security",
      "icon": "security",
      "label": "绑定数据范围",
      "sublabel": "操作与行列范围配对"
    },
    {
      "id": "assign",
      "lane": "policy",
      "col": 2,
      "type": "backend",
      "icon": "briefcase",
      "label": "按岗位授予",
      "sublabel": "记录部门或个人来源"
    },
    {
      "id": "request",
      "lane": "employee",
      "col": 0,
      "type": "frontend",
      "icon": "person",
      "label": "员工提交用途",
      "sublabel": "业务工作、范围、期限"
    },
    {
      "id": "map",
      "lane": "employee",
      "col": 1,
      "type": "backend",
      "icon": "briefcase",
      "label": "负责人匹配资源",
      "sublabel": "确定表、字段与行条件"
    },
    {
      "id": "approval",
      "lane": "employee",
      "col": 2,
      "type": "security",
      "icon": "decision",
      "label": "按责任范围审批",
      "sublabel": "独立项分审，组合全批"
    },
    {
      "id": "commit",
      "lane": "employee",
      "col": 3,
      "type": "database",
      "icon": "security",
      "label": "校验并写入授权",
      "sublabel": "核账号、范围和授予上限"
    },
    {
      "id": "use",
      "lane": "employee",
      "col": 4,
      "type": "security",
      "icon": "success",
      "label": "访问获准资源",
      "sublabel": "操作时核验当前权限"
    },
    {
      "id": "refused",
      "lane": "changes",
      "col": 2,
      "type": "security",
      "icon": "stop",
      "label": "保留驳回结论",
      "sublabel": "独立项互不牵连"
    },
    {
      "id": "stop",
      "lane": "changes",
      "col": 3,
      "type": "security",
      "icon": "stop",
      "label": "阻断失权访问",
      "sublabel": "重算其他有效来源"
    },
    {
      "id": "revoke",
      "lane": "changes",
      "col": 4,
      "type": "messagebus",
      "icon": "clock",
      "label": "撤权或账号停用",
      "sublabel": "复核在途任务与历史"
    }
  ],
  "edges": [
    {
      "id": "configure",
      "from": "roles",
      "to": "attach",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "direct",
      "from": "attach",
      "to": "assign",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "submit-direct",
      "from": "assign",
      "to": "commit",
      "label": "岗位授权",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "route",
      "from": "request",
      "to": "map",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "divide",
      "from": "map",
      "to": "approval",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "approved",
      "from": "approval",
      "to": "commit",
      "label": "获批",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "allow",
      "from": "commit",
      "to": "use",
      "label": "生效",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "decline",
      "from": "approval",
      "to": "refused",
      "label": "驳回",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "remove",
      "from": "use",
      "to": "revoke",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "refuse",
      "from": "revoke",
      "to": "stop",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "申请人看得见什么",
      "items": [
        "可填写企业公开的业务范围和用途。已获目录查看权的对象可预填，审批进度只展示允许公开的结论。",
        "部门归属可带来默认角色；企业可调整各角色的权限和适用范围。整表授权固定授予时的字段集合，新增列需另行授权。"
      ]
    },
    {
      "dot": "amber",
      "title": "审批通过后何时生效",
      "items": [
        "库存申请通过即可单独执行，销售项被驳回不撤销独立库存权限。须联用的子项全部获批并通过执行校验后，整组一次生效。",
        "变更权限的操作同样受企业授权和授予上限约束。出现过期或执行校验失败时，向申请人显示实际生效状态。"
      ]
    },
    {
      "dot": "rose",
      "title": "权限变化如何处理",
      "items": [
        "撤权后立即阻断失权范围内的在途查询、历史查看与下载；仅退出一个来源时，保留其他有效来源。账号停用时停止全部访问。"
      ]
    }
  ]
}