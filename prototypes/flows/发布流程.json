{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "知识如何发布",
    "locale": "zh-CN",
    "output": "prototypes/flows/发布流程.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "draft",
        "label": "文档与候选准备",
        "focus": [
          "confirm",
          "compose",
          "freeze"
        ],
        "note": "从已确认治理成果开始；文档确认与候选固定分别保留。"
      },
      {
        "id": "goLive",
        "label": "构建、测试与发布",
        "focus": [
          "build",
          "test",
          "preflight",
          "activate",
          "hold"
        ],
        "note": "候选测试与临切换复核分别通过后，整批切换并确认实际入口。"
      },
      {
        "id": "rollback",
        "label": "运行风险与回退",
        "focus": [
          "risk",
          "suspend",
          "rollbackRequest",
          "assess",
          "restore",
          "refused"
        ],
        "note": "风险处理和回退独立触发；回退仅到直接上一版，不解除当前限制。"
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "人员操作"
        },
        "backend": {
          "label": "平台处理"
        },
        "security": {
          "label": "验证与阻断"
        },
        "database": {
          "label": "知识与版本"
        },
        "messagebus": {
          "label": "运行变化"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "prepare",
      "label": "文档与候选准备"
    },
    {
      "id": "publish",
      "label": "构建、测试与发布"
    },
    {
      "id": "blocked",
      "label": "发布与回退阻断",
      "variant": "exception"
    },
    {
      "id": "operations",
      "label": "运行风险与回退"
    }
  ],
  "mainPath": [
    "confirm",
    "compose",
    "freeze",
    "build",
    "test",
    "preflight",
    "activate"
  ],
  "nodes": [
    {
      "id": "confirm",
      "lane": "prepare",
      "col": 0,
      "type": "database",
      "label": "已确认治理成果",
      "sublabel": "同源表字段、关系及指标口径",
      "icon": "database"
    },
    {
      "id": "compose",
      "lane": "prepare",
      "col": 1,
      "type": "frontend",
      "label": "整理并确认知识文档",
      "sublabel": "从已确认成果生成可编辑草稿",
      "icon": "person"
    },
    {
      "id": "freeze",
      "lane": "prepare",
      "col": 2,
      "type": "database",
      "label": "预检并固定候选",
      "sublabel": "范围、依赖、权限与内容修订",
      "icon": "flag"
    },
    {
      "id": "build",
      "lane": "publish",
      "col": 2,
      "type": "backend",
      "label": "构建隔离候选索引",
      "sublabel": "候选与当前正式入口分开",
      "icon": "backend"
    },
    {
      "id": "test",
      "lane": "publish",
      "col": 3,
      "type": "security",
      "label": "运行候选相关测试",
      "sublabel": "题单、测试身份及当前授权",
      "icon": "decision"
    },
    {
      "id": "preflight",
      "lane": "publish",
      "col": 4,
      "type": "security",
      "label": "切换前复核",
      "sublabel": "权限、版本、依赖与测试依据",
      "icon": "decision"
    },
    {
      "id": "activate",
      "lane": "publish",
      "col": 5,
      "type": "database",
      "label": "整批切换并确认生效",
      "sublabel": "知识与索引使用同一清单",
      "icon": "success"
    },
    {
      "id": "hold",
      "lane": "blocked",
      "col": 4,
      "type": "security",
      "label": "阻止本次发布",
      "sublabel": "保留原因及仍有效入口",
      "icon": "stop",
      "width": 160,
      "height": 76
    },
    {
      "id": "refused",
      "lane": "blocked",
      "col": 5,
      "type": "security",
      "label": "阻止本次回退",
      "sublabel": "保留当前版本及现有限制",
      "icon": "stop"
    },
    {
      "id": "risk",
      "lane": "operations",
      "col": 0,
      "type": "messagebus",
      "label": "结构失效或对象禁止",
      "sublabel": "沿依赖定位受影响知识",
      "icon": "flag"
    },
    {
      "id": "suspend",
      "lane": "operations",
      "col": 1,
      "type": "security",
      "label": "暂停受影响知识",
      "sublabel": "禁用失效对象，保留有效知识",
      "icon": "stop"
    },
    {
      "id": "rollbackRequest",
      "lane": "operations",
      "col": 3,
      "type": "frontend",
      "label": "申请整批回退",
      "sublabel": "明确当前版、上一版及目标范围",
      "icon": "person"
    },
    {
      "id": "assess",
      "lane": "operations",
      "col": 4,
      "type": "security",
      "label": "整批预检直接上一版",
      "sublabel": "结构、权限、禁止状态与关键题",
      "icon": "decision"
    },
    {
      "id": "restore",
      "lane": "operations",
      "col": 5,
      "type": "database",
      "label": "退回直接上一版",
      "sublabel": "整批切换，沿用当前限制",
      "icon": "success"
    }
  ],
  "edges": [
    {
      "id": "e-confirm-compose",
      "from": "confirm",
      "to": "compose",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "e-compose-freeze",
      "from": "compose",
      "to": "freeze",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "e-freeze-build",
      "from": "freeze",
      "to": "build",
      "role": "main",
      "variant": "default",
      "label": "预检通过"
    },
    {
      "id": "e-build-test",
      "from": "build",
      "to": "test",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "e-test-preflight",
      "from": "test",
      "to": "preflight",
      "role": "main",
      "variant": "emphasis",
      "label": "相关题全通过"
    },
    {
      "id": "e-preflight-activate",
      "from": "preflight",
      "to": "activate",
      "role": "main",
      "variant": "emphasis",
      "label": "复核通过"
    },
    {
      "id": "e-build-hold",
      "from": "build",
      "to": "hold",
      "role": "error",
      "variant": "security",
      "label": "构建失败"
    },
    {
      "id": "e-test-hold",
      "from": "test",
      "to": "hold",
      "role": "error",
      "variant": "security",
      "label": "无题或未全通过"
    },
    {
      "id": "e-preflight-hold",
      "from": "preflight",
      "to": "hold",
      "role": "error",
      "variant": "security",
      "label": "复核受阻"
    },
    {
      "id": "e-risk-suspend",
      "from": "risk",
      "to": "suspend",
      "role": "branch",
      "variant": "security",
      "label": "仅受影响部分"
    },
    {
      "id": "e-request-assess",
      "from": "rollbackRequest",
      "to": "assess",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "e-assess-restore",
      "from": "assess",
      "to": "restore",
      "role": "branch",
      "variant": "emphasis",
      "label": "全部通过"
    },
    {
      "id": "e-assess-refused",
      "from": "assess",
      "to": "refused",
      "role": "error",
      "variant": "security",
      "label": "缺失或预检失败"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "范围与内容确认",
      "items": [
        "每批固定同一数据源内的完整范围、必要依赖和确切修订；未确认内容不进入候选，其他范围保持独立。",
        "文档含义变化须回到治理条目重新确认；后续修改形成新候选，不能沿用旧候选成绩。"
      ]
    },
    {
      "dot": "amber",
      "title": "测试与切换门槛",
      "items": [
        "测试绑定本次候选、审核题单、受控身份及当前授权；无题、失败、未裁定、取消或执行异常都不算通过。",
        "临切换复核当前权限、禁止状态、基础版本、依赖和测试依据。切换结果不明时先核实实际入口，不直接宣称成功。",
        "失败不切换，仅仍有效的旧入口继续使用；首次发布无旧版时，相关业务暂不可用。"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行与回退边界",
      "items": [
        "普通更新中的在途问数可沿用仍有效旧版，当前权限和禁止状态持续生效；仅怀疑含义有误先待复核，不自动暂停。",
        "回退须有整个目标范围的权限，并通过当前结构、依赖、禁止状态和关键题单检查；只整批退回直接上一版，不恢复已撤销权限或自动解除暂停。",
        "同一回退请求重复提交返回原处理结果；修复、发布或回退都不能代替有权人员对暂停与禁止的显式解除。"
      ]
    }
  ]
}
