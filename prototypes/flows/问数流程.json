{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "单源问数与反馈处理",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "问数流程.html",
    "views": [
      {
        "id": "ask",
        "label": "从提问到回答",
        "focus": [
          "ask",
          "understand",
          "generate",
          "check",
          "source",
          "answer"
        ],
        "note": "已发布知识提供业务口径；通过校验的 SQL 在本次选中的业务数据库上只读执行。"
      },
      {
        "id": "retry",
        "label": "重写还是追问",
        "focus": [
          "understand",
          "generate",
          "check",
          "clarify",
          "stop",
          "gap"
        ],
        "note": "SQL 表达可修复且预算尚足时，带原因重新生成并完整校验；缺用户条件就追问，缺正式口径则转治理。"
      },
      {
        "id": "feedback",
        "label": "问题如何回告",
        "focus": [
          "gap",
          "rate",
          "queue",
          "business",
          "technical",
          "verify",
          "notify"
        ],
        "note": "业务修订须生效、技术修复须交付，再用原问题复验。核实无需变更的事项直接回告依据。"
      }
    ],
    "legend": {
      "entries": {
        "frontend": {
          "label": "人员操作"
        },
        "backend": {
          "label": "平台处理"
        },
        "database": {
          "label": "所选业务库"
        },
        "security": {
          "label": "校验与阻断"
        },
        "messagebus": {
          "label": "事项流转"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "stops",
      "label": "追问或停止",
      "variant": "exception"
    },
    {
      "id": "question",
      "label": "员工问一次数"
    },
    {
      "id": "issue",
      "label": "问题核实与分派"
    },
    {
      "id": "fix",
      "label": "处理与回告"
    }
  ],
  "mainPath": [
    "ask",
    "understand",
    "generate",
    "check",
    "source",
    "answer"
  ],
  "nodes": [
    {
      "id": "ask",
      "lane": "question",
      "col": 0,
      "type": "frontend",
      "label": "员工选源提问",
      "sublabel": "选定一个已授权业务源",
      "icon": "person"
    },
    {
      "id": "understand",
      "lane": "question",
      "col": 1,
      "type": "backend",
      "label": "理解并补齐依据",
      "sublabel": "已发布知识与同版口径",
      "icon": "decision"
    },
    {
      "id": "generate",
      "lane": "question",
      "col": 2,
      "type": "backend",
      "label": "生成 SQL",
      "sublabel": "依照意图、口径与授权",
      "icon": "backend"
    },
    {
      "id": "check",
      "lane": "question",
      "col": 3,
      "type": "security",
      "label": "校验 SQL",
      "sublabel": "先核对语义，再查安全权限",
      "icon": "decision"
    },
    {
      "id": "source",
      "lane": "question",
      "col": 4,
      "type": "database",
      "label": "所选业务数据库",
      "sublabel": "复核权限后只读执行",
      "icon": "database"
    },
    {
      "id": "answer",
      "lane": "question",
      "col": 5,
      "type": "frontend",
      "label": "交付本次答案",
      "sublabel": "数字、表格或图表",
      "icon": "success"
    },
    {
      "id": "clarify",
      "lane": "stops",
      "col": 1,
      "type": "frontend",
      "label": "追问原提问人",
      "sublabel": "请本人明确时间、口径等条件",
      "icon": "waiting"
    },
    {
      "id": "stop",
      "lane": "stops",
      "col": 4,
      "type": "security",
      "label": "停止本次尝试",
      "sublabel": "无权或自动重试已达上限",
      "icon": "stop"
    },
    {
      "id": "gap",
      "lane": "issue",
      "col": 1,
      "type": "messagebus",
      "label": "登记治理事项",
      "sublabel": "缺口自动归并，用户可补充",
      "icon": "messagebus"
    },
    {
      "id": "business",
      "lane": "issue",
      "col": 2,
      "type": "backend",
      "label": "修订业务知识",
      "sublabel": "审核、候选测试、发布",
      "icon": "briefcase"
    },
    {
      "id": "queue",
      "lane": "issue",
      "col": 4,
      "type": "messagebus",
      "label": "受理并核实点踩",
      "sublabel": "记录原因，按实情分派",
      "icon": "messagebus"
    },
    {
      "id": "rate",
      "lane": "issue",
      "col": 5,
      "type": "frontend",
      "label": "评价自己的回答",
      "sublabel": "仅原提问人可评价",
      "icon": "person"
    },
    {
      "id": "verify",
      "lane": "fix",
      "col": 2,
      "type": "backend",
      "label": "生效后复验",
      "sublabel": "原问题和相关案例均通过",
      "icon": "success"
    },
    {
      "id": "notify",
      "lane": "fix",
      "col": 3,
      "type": "frontend",
      "label": "回告原提问人",
      "sublabel": "说明处理结论及其依据",
      "icon": "person"
    },
    {
      "id": "technical",
      "lane": "fix",
      "col": 4,
      "type": "backend",
      "label": "修复技术问题",
      "sublabel": "验证并交付程序修复",
      "icon": "backend"
    }
  ],
  "edges": [
    {
      "id": "ask-understand",
      "from": "ask",
      "to": "understand"
    },
    {
      "id": "understand-generate",
      "from": "understand",
      "to": "generate"
    },
    {
      "id": "generate-check",
      "from": "generate",
      "to": "check"
    },
    {
      "id": "check-source",
      "from": "check",
      "to": "source",
      "label": "均通过",
      "variant": "emphasis"
    },
    {
      "id": "source-answer",
      "from": "source",
      "to": "answer",
      "label": "实际结果"
    },
    {
      "id": "check-generate",
      "from": "check",
      "to": "generate",
      "label": "可修复",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "understand-clarify",
      "from": "understand",
      "to": "clarify",
      "label": "有歧义",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "check-clarify",
      "from": "check",
      "to": "clarify",
      "label": "缺用户条件",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "clarify-understand",
      "from": "clarify",
      "to": "understand",
      "label": "已补充",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "check-stop",
      "from": "check",
      "to": "stop",
      "label": "无权或超限",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "understand-gap",
      "from": "understand",
      "to": "gap",
      "label": "知识缺口",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "gap-business",
      "from": "gap",
      "to": "business",
      "label": "核实需修订"
    },
    {
      "id": "answer-rate",
      "from": "answer",
      "to": "rate",
      "label": "可选",
      "role": "branch"
    },
    {
      "id": "rate-queue",
      "from": "rate",
      "to": "queue",
      "label": "有效点踩",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "queue-business",
      "from": "queue",
      "to": "business",
      "label": "口径有误"
    },
    {
      "id": "queue-technical",
      "from": "queue",
      "to": "technical",
      "label": "技术问题"
    },
    {
      "id": "business-verify",
      "from": "business",
      "to": "verify",
      "label": "发布后"
    },
    {
      "id": "technical-verify",
      "from": "technical",
      "to": "verify",
      "label": "交付后"
    },
    {
      "id": "verify-notify",
      "from": "verify",
      "to": "notify",
      "label": "通过"
    },
    {
      "id": "queue-notify",
      "from": "queue",
      "to": "notify",
      "label": "无需修改"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "重写 SQL 的上限",
      "items": [
        "语义偏差、语法或方言错误可以修复时，以同一意图和授权范围带原因重写。新 SQL 须重新校验。",
        "默认每次请求最多生成 3 个 SQL 候选；连续重复同一失败时提前停止。用户补充条件不重置预算。"
      ]
    },
    {
      "dot": "amber",
      "title": "条件缺失时问谁",
      "items": [
        "存在多个合理口径，或生成和校验时发现关键时间、指标未明确，向本人追问。收到答复后重解意图、重新匹配同版依据。",
        "若平台确认缺少已审核的业务知识，本次问数以知识不足结束，自动关联治理事项。仅未检索到候选时先核对证据。"
      ]
    },
    {
      "dot": "violet",
      "title": "数据与结果归属",
      "items": [
        "所选业务库提供查询数值。跨源分析以超出问数范围结束；失权时停止，可按业务用途申请访问。",
        "已交付数值或表格时，解释失败单独标记。点赞进入统计，点踩由有权人员核实，处理结果按原提问人当前权限回告。"
      ]
    }
  ]
}