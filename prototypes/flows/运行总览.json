  "mainPath": [
    "catalog",
    "confirm",
    "build",
    "publish",
    "retrieve",
    "execute",
    "answer"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "谁能看到什么",
      "items": [
        "企业可以给任一角色配置操作和数据范围。查看、审核、发布和回退分别授权。",
        "员工按业务用途申请额外访问；由负责人匹配实际资源，授予生效后才能查询。"
      ]
    },
    {
      "dot": "emerald",
      "title": "用超市问题走一遍",
      "items": [
        "店长选择经营数据源，问“本店上周净卖出多少盒牛奶？”",
        "有多个销量口径时先追问。缺少已确认的退货口径时，关联治理事项，用户可补充。"
      ]
    },
    {
      "dot": "violet",
      "title": "如何判断一次交付",
      "items": [
        "仅原提问人能评价自己的回答。点赞进入统计；点踩进入处理队列。",
        "已交付的表格即使解释失败也保留，注明“解释未完成”。看板分别呈现交付率与业务正确率。"
      ]
    },
    {
      "dot": "slate",
      "title": "运营看板观察什么",
      "items": [
        "按当前权限汇总可用知识、问数终态、反馈事项、评测与模型用量，支持查看对应明细。",
        "有效点踩立即入队；同类反馈达到已启用的提醒门槛后，才提示重点检查。"
      ]
    }
  ]
}