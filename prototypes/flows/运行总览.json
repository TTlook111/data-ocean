{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "DataOcean 项目运行总图",
    "output": "运行总览.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ready",
        "label": "准备可问的数据",
        "focus": [
          "configure",
          "models",
          "catalog",
          "confirm",
          "build",
          "publish"
        ],
        "note": "企业分配操作与数据范围，治理人员确认业务口径。候选测试通过后才切换本次发布范围。"
      },
      {
        "id": "ask",
        "label": "交付一次回答",
        "focus": [
          "ask",
          "publish",
          "retrieve",
          "execute",
          "answer"
        ],
        "note": "员工每次选择一个可用数据源。按当前权限取同版依据，再检查并执行只读查询。"
      },
      {
        "id": "improve",
        "label": "发现和处理问题",
        "focus": [
          "retrieve",
          "rate",
          "intake",
          "issue",
          "verify",
          "tell",
          "monitor"
        ],
        "note": "知识缺口自动关联事项，有效点踩进入队列。修复经过验证后回告，运营看板按权限汇总。"
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "人员操作"
        },
        "backend": {
          "label": "系统处理"
        },
        "database": {
          "label": "数据与知识"
        },
        "security": {
          "label": "授权与校验"
        },
        "messagebus": {
          "label": "事项与通知"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "settings",
      "label": "配置与运营"
    },
    {
      "id": "knowledge",
      "label": "治理与发布"
    },
    {
      "id": "question",
      "label": "员工问数"
    },
    {
      "id": "improve",
      "label": "反馈与改进"
    }
  ],
  "nodes": [
