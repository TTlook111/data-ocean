{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "DataOcean 项目运行总图",
    "output": "运行总览.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "oneQuery",
        "label": "员工问一次数",
        "focus": [
          "ask",
          "resolve",
          "generate",
          "check",
          "businessDb",
          "answer"
        ],
        "note": "从员工选择一个数据源提问开始。已发布口径用于生成 SQL，实际业务数值由所选业务库返回。"
      },
      {
        "id": "retry",
        "label": "重写或追问",
        "focus": [
          "resolve",
          "clarify",
          "generate",
          "check",
          "businessDb"
        ],
        "note": "可修复的 SQL 带原因返回生成。缺用户条件时暂停追问，答复后重新理解、取依据、生成并校验。"
      },
      {
        "id": "knowledgePrep",
        "label": "企业准备知识",
        "focus": [
          "catalog",
          "confirm",
          "publish",
          "knowledge",
          "resolve"
        ],
        "note": "治理人员确认定义，候选通过测试后发布。同一份有效知识可供多个问题读取。"
      },
      {
        "id": "closeIssue",
        "label": "从发现到回告",
        "focus": [
          "gap",
          "rating",
          "triage",
          "fix",
          "verify",
          "tell"
        ],
        "note": "知识不足与本人点踩分别进入事项处理。修正生效后复验；无需改动时，记录依据并向本人回告。"
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "人员操作"
        },
        "backend": {
          "label": "系统处理"
        },
        "database": {
          "label": "数据与知识"
        },
        "security": {
          "label": "校验"
        },
        "messagebus": {
          "label": "事项与回告"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "prepare",
      "label": "企业准备可复用的知识"
    },
    {
      "id": "query",
      "label": "员工问一次数"
    },
    {
      "id": "handle",
      "label": "发现问题、处理与回告"
    }
  ],
  "nodes": [
    {
      "id": "catalog",
      "lane": "prepare",
      "col": 0,
      "type": "database",
      "label": "只读采集元数据",
      "sublabel": "表、字段和关系",
      "icon": "database"
    },
    {
      "id": "confirm",
      "lane": "prepare",
      "col": 1,
      "type": "frontend",
      "label": "人工确认业务口径",
      "sublabel": "AI 辅助整理，逐项审核",
      "icon": "person"
    },
    {
      "id": "publish",
      "lane": "prepare",
      "col": 2,
      "type": "security",
      "label": "验证并发布候选",
      "sublabel": "按题目身份测试通过",
      "icon": "decision"
    },
    {
      "id": "knowledge",
      "lane": "prepare",
      "col": 3,
      "type": "database",
      "label": "已发布的业务知识",
      "sublabel": "有效定义、关系与计算规则",
      "icon": "database"
    },
    {
      "id": "ask",
      "lane": "query",
      "col": 0,
      "type": "frontend",
      "label": "员工选源并提问",
      "sublabel": "例如：本店上周净销量？",
      "icon": "person",
      "yOffset": 22
    },
    {
      "id": "resolve",
      "lane": "query",
      "col": 1,
      "type": "backend",
      "label": "理解问题并取口径",
      "sublabel": "读取获准的同版详细依据",
      "icon": "backend",
      "yOffset": 22
    },
    {
      "id": "generate",
      "lane": "query",
      "col": 2,
      "type": "backend",
      "label": "生成 SQL",
      "sublabel": "依据意图、口径和方言",
      "icon": "backend",
      "yOffset": 22
    },
    {
      "id": "check",
      "lane": "query",
      "col": 3,
      "type": "security",
      "label": "校验 SQL",
      "sublabel": "先核需求语义，再查安全权限",
      "icon": "decision",
      "yOffset": 22
    },
    {
      "id": "businessDb",
      "lane": "query",
      "col": 4,
      "type": "database",
      "label": "所选企业业务库",
      "sublabel": "在获准行列内只读执行",
      "icon": "database",
      "yOffset": 22
    },
    {
      "id": "answer",
      "lane": "query",
      "col": 5,
      "type": "frontend",
      "label": "交付本次答案",
      "sublabel": "实际数值、口径及查询时间",
      "icon": "success",
      "yOffset": 22
    },
    {
      "id": "clarify",
      "lane": "query",
      "col": 1,
      "type": "frontend",
      "label": "追问原提问人",
      "sublabel": "保留已知条件，等待补充",
      "icon": "waiting",
      "yOffset": -69
    },
    {
      "id": "gap",
      "lane": "handle",
      "col": 1,
      "type": "messagebus",
      "label": "自动关联治理事项",
      "sublabel": "本次知识不足，同一缺口归并",
      "icon": "briefcase",
      "yOffset": -26
    },
    {
      "id": "rating",
      "lane": "handle",
      "col": 5,
      "type": "messagebus",
      "label": "本人点踩并说明原因",
      "sublabel": "已交付回答的反馈进入队列",
      "icon": "messagebus",
      "yOffset": -26
    },
    {
      "id": "triage",
      "lane": "handle",
      "col": 1,
      "type": "frontend",
      "label": "分派并核实原因",
      "sublabel": "查原问题、实际依据与影响",
      "icon": "person",
      "yOffset": 42
    },
    {
      "id": "fix",
      "lane": "handle",
      "col": 2,
      "type": "backend",
      "label": "完成修正并生效",
      "sublabel": "知识重审发布或技术修复交付",
      "icon": "active",
      "yOffset": 42
    },
    {
      "id": "verify",
      "lane": "handle",
      "col": 3,
      "type": "security",
      "label": "按原问题复验",
      "sublabel": "核对已生效版本与相关用例",
      "icon": "decision",
      "yOffset": 42
    },
    {
      "id": "tell",
      "lane": "handle",
      "col": 5,
      "type": "messagebus",
      "label": "回告原提问人",
      "sublabel": "按本人当前权限说明结论",
      "icon": "flag",
      "yOffset": 42
    }
  ],
  "mainPath": [
    "ask",
    "resolve",
    "generate",
    "check",
    "businessDb",
    "answer"
  ],
  "edges": [
    {
      "id": "ask-resolve",
      "from": "ask",
      "to": "resolve"
    },
    {
      "id": "resolve-generate",
      "from": "resolve",
      "to": "generate",
      "label": "依据齐全"
    },
    {
      "id": "generate-check",
      "from": "generate",
      "to": "check"
    },
    {
      "id": "check-businessDb",
      "from": "check",
      "to": "businessDb",
      "label": "通过"
    },
    {
      "id": "businessDb-answer",
      "from": "businessDb",
      "to": "answer",
      "label": "取回结果"
    },
    {
      "id": "resolve-gap",
      "from": "resolve",
      "to": "gap",
      "label": "已定位知识缺口",
      "role": "branch",
      "variant": "security"
    },
    {
      "id": "answer-rating",
      "from": "answer",
      "to": "rating",
      "label": "可选点踩",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "gap-triage",
      "from": "gap",
      "to": "triage"
    },
    {
      "id": "triage-fix",
      "from": "triage",
      "to": "fix",
      "label": "需要修正"
    },
    {
      "id": "fix-verify",
      "from": "fix",
      "to": "verify"
    },
    {
      "id": "verify-tell",
      "from": "verify",
      "to": "tell",
      "label": "复验通过"
    },
    {
      "id": "clarify-resolve",
      "from": "clarify",
      "to": "resolve",
      "label": "本人补充",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "check-generate",
      "from": "check",
      "to": "generate",
      "label": "可修复，限次重写",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "resolve-clarify",
      "from": "resolve",
      "to": "clarify",
      "label": "条件不清",
      "role": "branch",
      "variant": "security"
    },
    {
      "id": "check-clarify",
      "from": "check",
      "to": "clarify",
      "label": "仍缺条件",
      "role": "branch",
      "variant": "security"
    },
    {
      "id": "knowledge-resolve",
      "from": "knowledge",
      "to": "resolve",
      "label": "读取口径",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "catalog-confirm",
      "from": "catalog",
      "to": "confirm"
    },
    {
      "id": "confirm-publish",
      "from": "confirm",
      "to": "publish"
    },
    {
      "id": "publish-knowledge",
      "from": "publish",
      "to": "knowledge"
    },
    {
      "id": "rating-triage",
      "from": "rating",
      "to": "triage"
    },
    {
      "id": "triage-tell",
      "from": "triage",
      "to": "tell",
      "label": "无需修改，有据结案",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "verify-fix",
      "from": "verify",
      "to": "fix",
      "label": "复验未过",
      "role": "return",
      "variant": "dashed"
    }
  ],
  "semanticChecks": {
    "requiredEdges": [
      {
        "from": "ask",
        "to": "resolve"
      },
      {
        "from": "resolve",
        "to": "generate"
      },
      {
        "from": "generate",
        "to": "check"
      },
      {
        "from": "check",
        "to": "businessDb"
      },
      {
        "from": "businessDb",
        "to": "answer"
      },
      {
        "from": "check",
        "to": "generate"
      },
      {
        "from": "check",
        "to": "clarify"
      },
      {
        "from": "clarify",
        "to": "resolve"
      },
      {
        "from": "knowledge",
        "to": "resolve"
      },
      {
        "from": "resolve",
        "to": "gap"
      },
      {
        "from": "answer",
        "to": "rating"
      },
      {
        "from": "verify",
        "to": "tell"
      },
      {
        "from": "triage",
        "to": "tell"
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "口径和数字各从哪里来",
      "items": [
        "店长问本店上周净销量时，已发布知识提供销售减退货的算法、时间字段和计量单位。",
        "SQL 在本次选定的经营业务库内只读执行，答案使用这次返回的数值。"
      ]
    },
    {
      "dot": "amber",
      "title": "查询未通过时如何继续",
      "items": [
        "可修复的 SQL 携带失败原因回到生成节点，每次重写都重走校验。默认最多生成 3 个候选，同错无进展或超预算就停止。",
        "需要员工确认日期、门店或业务场景时暂停；答复后重新理解并检查依据。无权限、对象已禁用或断连时停止执行。"
      ]
    },
    {
      "dot": "emerald",
      "title": "知识不足与点踩分开处理",
      "items": [
        "必要口径确实缺失时，原问数以知识不足结束，自动建立或关联事项；用户无需先点踩即可补充。",
        "只有原提问人可评价自己的回答。修复后验证完成再回告；核查后无需修改，则说明理由。"
      ]
    },
    {
      "dot": "slate",
      "title": "贯穿三条流程的配置与观察",
      "items": [
        "企业配置角色、数据范围和模型用途；在读取知识、执行、交付与历史回看时核验当前权限。",
        "运营看板按可见范围汇总发布状态、各类问数终态、反馈事项、评测质量和模型用量。"
      ]
    }
  ]
}